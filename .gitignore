# ========================
# Java 核心
# ========================
# 编译输出
*.class
*.jar
*.war
*.ear
*.nar

# 但保留 lib 目录下的依赖 jar
!src/main/resources/lib/*.jar

# 日志
*.log

# 本地库 / JNI
*.so
*.dll
*.dylib

# ========================
# 构建工具 - Maven
# ========================
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ========================
# 构建工具 - Gradle
# ========================
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ========================
# IDE / 编辑器
# ========================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
.factorypath
bin/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Vim / Neovim
*.swp
*.swo
*~

# ========================
# 操作系统 / 杂项
# ========================
.DS_Store
Thumbs.db
Desktop.ini

# 敏感信息（务必忽略）
*.pem
*.key
*.p12
*.jks
*.keystore
.env
.env.*.local
secrets/
credentials/

# ========================
# 其他常见 Java 生态
# ========================
# Lombok 生成（通常不需要提交）
lombok.config

# SonarQube
.sonar/

# JRebel
rebel.xml

# Spring Boot DevTools
spring-devtools.properties

.arts/
.codeartsdoer/
.mvn/
.gradle/

# 本地环境配置（包含敏感密钥）
application-local.yml

# 运行时生成的目录
temp/
output/

# agents
.agents/